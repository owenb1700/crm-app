rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Pipeline files (project plans, bid documents, etc.) are private to
    // the pipeline entry's owner, read-only for admins -- same model as
    // pipeline notes in Firestore. Cross-references the pipeline doc's
    // ownerId in Firestore to decide access.
    match /pipeline/{pipelineId}/{fileName} {
      function isSignedIn() {
        return request.auth != null;
      }

      function pipelineOwnerId() {
        return firestore.get(/databases/(default)/documents/pipeline/$(pipelineId)).data.ownerId;
      }

      function isAdmin() {
        return isSignedIn() &&
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if isSignedIn() && (pipelineOwnerId() == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && pipelineOwnerId() == request.auth.uid;
    }

    // Project drawings are visible to the whole team (like the project
    // record itself), but only the project's owner or an admin can
    // upload/replace/delete them.
    match /customers/{customerId}/{fileName} {
      function isSignedIn() {
        return request.auth != null;
      }

      function customerOwnerId() {
        return firestore.get(/databases/(default)/documents/customers/$(customerId)).data.ownerId;
      }

      function isAdmin() {
        return isSignedIn() &&
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if isSignedIn();
      allow write: if isSignedIn() && (customerOwnerId() == request.auth.uid || isAdmin());
    }

    // Tower model drawings are shared reference material, not owned by
    // any one person -- same "anyone signed in can manage" model as the
    // companies/contacts directory records.
    match /towerModels/{modelId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
