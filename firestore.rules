rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Signed in AND still an active account. Deactivating someone has to
    // lock them out of the data itself, not just out of the app's screens.
    function isActive() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) == false;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The "Enter Projects for Other People" permission. Admins always have
    // it; everyone else needs it granted in Admin Settings.
    function canEnterForOthers() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('enterForOthers', false) == true);
    }

    function customerData(customerId) {
      return get(/databases/$(database)/documents/customers/$(customerId)).data;
    }

    function isOwner(customerId) {
      return customerData(customerId).ownerId == request.auth.uid;
    }

    function isCollaborator(customerId) {
      return request.auth.uid in customerData(customerId).get('collaboratorIds', []);
    }

    // Marks that the one-time bootstrap admin has been created, so no one
    // else can self-assign the admin role after that point.
    match /system/config {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/system/config);
      allow update: if isAdmin();
    }

    // Publicly readable (no auth) so the forgot-password screen can refuse
    // to send a reset email for a disabled account before anyone signs in.
    // Exposes nothing but a boolean per email -- no names, roles, or uids.
    match /disabledEmails/{email} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // What the nightly jobs did, kept for 30 days. Written only by the
    // server (the Admin SDK ignores these rules); admins can read it back
    // long after Vercel's own logs have expired.
    match /cronRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Parts: small quoted/sold items, shared by the whole team. Anyone
    // active can add one and anyone can edit one (a teammate updating a
    // stage is the normal case); only whoever entered it, or an admin, can
    // delete it.
    match /parts/{partId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isActive() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isActive() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == 'member') ||
        (request.auth.uid == userId && request.resource.data.role == 'admin' &&
          !exists(/databases/$(database)/documents/system/config))
      );

      // Self-updates cannot change your own role or disabled status --
      // only an existing admin can promote/demote or deactivate anyone.
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.disabled == resource.data.disabled)
      );
      allow delete: if isAdmin();
    }

    // Whoever owns a pipeline entry (or an admin) converts it into a project
    // assigned to a chosen salesperson -- so the project can be created
    // with someone else as its owner, but only from a real pipeline entry
    // that the person converting actually owns.
    function isConvertingOwnPipeline(data) {
      return data.get('sourcePipelineId', null) is string &&
        exists(/databases/$(database)/documents/pipeline/$(data.sourcePipelineId)) &&
        (get(/databases/$(database)/documents/pipeline/$(data.sourcePipelineId)).data.ownerId == request.auth.uid || isAdmin());
    }

    match /customers/{customerId} {
      allow read: if isActive();
      allow create: if isActive() && (
        request.resource.data.ownerId == request.auth.uid ||
        isConvertingOwnPipeline(request.resource.data) ||
        // Filed on someone else's behalf: allowed only with the permission,
        // and only if whoever entered it stays on the project as a
        // collaborator -- so it's never a way to put data somewhere you
        // can't see it afterwards.
        (canEnterForOthers() && request.auth.uid in request.resource.data.get('collaboratorIds', []))
      );
      allow delete: if isActive() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());

      // Owner/admin can change anything. A collaborator may ALSO update,
      // but only to remove themselves from collaboratorIds -- nothing else
      // about the entry, and they can't touch anyone else's access.
      allow update: if isActive() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        (
          request.auth.uid in resource.data.get('collaboratorIds', []) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaboratorIds']) &&
          !(request.auth.uid in request.resource.data.get('collaboratorIds', []))
        )
      );

      // Notes are visible to the owner, any approved collaborator, or any
      // admin (read-only for admin -- they can see but not silently edit
      // someone else's notes).
      match /private/{doc} {
        allow read: if isActive() &&
          (isOwner(customerId) || isCollaborator(customerId) || isAdmin());
        allow write: if isActive() &&
          (isOwner(customerId) || isCollaborator(customerId));
        // The person converting a pipeline entry seeds the new project's
        // private notes and bid files once, even though the project belongs
        // to the salesperson they assigned. Create only -- never edit after.
        allow create: if isActive() && isConvertingOwnPipeline(customerData(customerId));
      }

      // A teammate can request to collaborate on an entry they don't own.
      // Only the owner (or the requester themselves, to cancel) can
      // approve/deny by updating or deleting the request.
      match /collabRequests/{requesterId} {
        allow read: if isActive() &&
          (request.auth.uid == requesterId || isOwner(customerId) || isAdmin());
        allow create: if isActive() &&
          request.auth.uid == requesterId && !isOwner(customerId);
        allow update, delete: if isActive() &&
          (isOwner(customerId) || request.auth.uid == requesterId);
      }

      // Drawings are NOT private -- unlike notes, anyone signed in can see
      // a project's uploaded PDFs (same "everyone can view" model as the
      // rest of the project record). Only the owner/admin can upload or
      // delete, matching who can edit the project itself.
      match /drawings/{doc} {
        allow read: if isActive();
        allow write: if isActive() && (isOwner(customerId) || isAdmin());
      }

      // Photos: the whole team can see them. The owner, collaborators, and
      // admins can add photos (and whoever converts a pipeline entry brings
      // its photos along); a photo's uploader, the owner, or an admin can
      // change its date/caption or delete it.
      match /photos/{photoId} {
        allow read: if isActive();
        allow create: if isActive() && (
          (request.resource.data.uploadedBy == request.auth.uid &&
            (isOwner(customerId) || isCollaborator(customerId) || isAdmin())) ||
          isConvertingOwnPipeline(customerData(customerId))
        );
        allow update, delete: if isActive() &&
          (resource.data.uploadedBy == request.auth.uid || isOwner(customerId) || isAdmin());
      }
    }

    // PIPELINE: pre-bid/bidding/design/budgeting opportunities, tracked
    // separately from won projects. Unlike customers, every signed-in user
    // can edit the project details and Contractors Bidding -- these are
    // meant to be worked on as a team (salesperson, project point person,
    // anyone who's added it to their own dashboard). Only the owner/admin
    // can delete the entry itself, and private notes/files stay locked
    // down below.
    match /pipeline/{pipelineId} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isActive();
      allow delete: if isActive() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());

      // Notes + files are private to the owner (read-only for admin).
      match /private/{doc} {
        allow read: if isActive() &&
          (get(/databases/$(database)/documents/pipeline/$(pipelineId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if isActive() &&
          get(/databases/$(database)/documents/pipeline/$(pipelineId)).data.ownerId == request.auth.uid;
      }

      // "My notes": one document per person, and only that person can ever
      // read or write it -- not the entry's owner, not an admin.
      match /myNotes/{userId} {
        allow read, write: if isActive() && request.auth.uid == userId;
      }

      // "Team notes": everyone working the entry reads and adds. Notes are
      // appended, never edited, so the thread stays a record of what was
      // known when -- nothing here is ever deleted, including after the
      // entry is won, lost, or converted into a project.
      match /teamNotes/{doc} {
        allow read: if isActive();
        allow create: if isActive();
        allow update: if isActive() &&
          request.resource.data.entries.size() >= resource.data.entries.size();
        allow delete: if false;
      }

      // Photos: like the entry itself, the whole team can see and add them.
      // A photo's uploader, the entry's owner, or an admin can change its
      // date/caption or delete it.
      match /photos/{photoId} {
        allow read: if isActive();
        allow create: if isActive() && request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if isActive() && (
          resource.data.uploadedBy == request.auth.uid ||
          get(/databases/$(database)/documents/pipeline/$(pipelineId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // DIRECTORY: shared company/contact reference data, built up
    // automatically from projects and pipeline entries plus manual edits.
    // Not owned by any one person -- any signed-in user can read, create,
    // or update (so the whole team can enrich/correct shared records);
    // only admins can delete, to guard against accidental data loss.
    match /companies/{companyId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // One record per normalized company name ("abc-mechanical"), pointing at
    // the company that owns it. Creating a company claims its key in the
    // same transaction, so the same firm can't be created twice even by two
    // people at once. Team-maintained, like companies themselves.
    match /companyKeys/{key} {
      allow read, write: if isActive();
    }

    // Groups an admin marked "not duplicates" on Find Duplicates (written by
    // the server).
    match /duplicateDismissals/{groupId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Tower models (manufacturer + model number) with their shared PDF
    // drawings -- same shared-reference-data model as companies/contacts.
    // Drawings live in the "drawings" array field directly on this doc,
    // so no extra subcollection rule is needed for them.
    match /towerModels/{modelId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Product spec library (cooling towers, chillers, strainers, etc.) --
    // a reusable catalog for quoting prospective work, not tied to any
    // installed/serialized equipment. Shared reference data like
    // companies/contacts/towerModels: any signed-in user can add or edit,
    // only admins can delete.
    match /products/{productId} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Personal reminders: private to the one person who made them -- not
    // even admins can read someone else's. Completing one deletes it.
    match /reminders/{reminderId} {
      allow read, delete: if isActive() && resource.data.userId == request.auth.uid;
      // Normally you only create your own. The exception is "remind
      // everyone on this entry": anyone working a pipeline entry can set a
      // reminder for a teammate on that entry, and it records who set it.
      // The recipient can delete it like any of their own.
      allow create: if isActive() && (
        request.resource.data.userId == request.auth.uid ||
        (
          request.resource.data.get('setBy', null) == request.auth.uid &&
          request.resource.data.get('pipelineId', null) is string &&
          exists(/databases/$(database)/documents/pipeline/$(request.resource.data.pipelineId))
        )
      );
      allow update: if isActive() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
    }

    // Alerts bell: in-app notifications, separate from (and independent
    // of) whether the accompanying email actually gets delivered. Anyone
    // signed in can create one addressed to another user (e.g. a
    // collaboration request notifies the owner), but only the recipient
    // can read, mark read, or delete their own.
    match /notifications/{notificationId} {
      allow read, update, delete: if isActive() && resource.data.userId == request.auth.uid;
      allow create: if isActive();
    }
  }
}
